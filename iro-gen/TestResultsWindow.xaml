<Window x:Class="IroGen.TestResultsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Testergebnisse auswerten" Width="1240" Height="820" MinWidth="900" MinHeight="560"
 WindowStartupLocation="CenterOwner"
 Background="#F3F5F1" Foreground="#26382F" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="Womit kam Iro klar, wo gab es Probleme?" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock x:Name="Summary" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>

  <Border Grid.Row="1" Background="#FFF6E2" BorderBrush="#E4D2A6" BorderThickness="1" CornerRadius="8"
          Padding="12" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock TextWrapping="Wrap" Text="Diese Bewertung ist eine Entwicklungsdiagnose, keine Abnahme. Für gestörte Bilder ist im Testauftrag kein geprüftes Sollverhalten hinterlegt: Eine abgewiesene Messung kann richtig sein. Eindeutig fehlerhaft ist nur eine freigegebene Messung, deren Wert zu weit vom nominalen Sollabstand abweicht."/>
    <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
     <TextBlock Text="Zulässige Abweichung vom Sollabstand (ΔE00)" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox x:Name="Tolerance" Text="1,0" Width="70" Margin="0,0,12,0" TextChanged="Tolerance_Changed"
              AutomationProperties.Name="Zulässige Abweichung vom nominalen Sollabstand in Delta E 2000"/>
     <CheckBox x:Name="OnlyProblems" Content="Nur Läufe mit Problemen zeigen" VerticalAlignment="Center"
               Margin="0,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
     <Button Content="Neu einlesen" Click="Reload_Click"/>
    </WrapPanel>
   </StackPanel>
  </Border>

  <DataGrid Grid.Row="2" x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
            HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderBrush="#DFE5DB"
            RowHeaderWidth="0" VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="Testläufe mit gesetzten Optionen und Ergebnis">
   <DataGrid.RowStyle>
    <Style TargetType="DataGridRow">
     <Setter Property="VerticalContentAlignment" Value="Top"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding Verdict}" Value="Erreicht">
       <Setter Property="Background" Value="#EDF6EA"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Verdict}" Value="FalscherMesswert">
       <Setter Property="Background" Value="#FBE4E1"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Verdict}" Value="Teilweise">
       <Setter Property="Background" Value="#FFF6E2"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Verdict}" Value="Fehler">
       <Setter Property="Background" Value="#FBE4E1"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="90"/>
    <DataGridTextColumn Header="Szene" Binding="{Binding Scene}" Width="200">
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Gesetzte Störungen" Binding="{Binding Disturbances}" Width="180">
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Ergebnis" Binding="{Binding VerdictText}" Width="180">
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Befund" Binding="{Binding Finding}" Width="230">
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Meldung der App" Binding="{Binding Message}" Width="*">
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>

  <WrapPanel Grid.Row="3" Margin="0,14,0,0">
   <Button Content="Kompakten Bericht exportieren" Click="Export_Click"/>
   <Button Content="Ordner des Laufs öffnen" Click="OpenFolder_Click"/>
   <Button Content="Schließen" Click="Close_Click" IsCancel="True"/>
  </WrapPanel>
 </Grid>
</Window>
