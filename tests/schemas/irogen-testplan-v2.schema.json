{
  "title": "IroGen-Testplan v2",
  "required": [
    "formatVersion",
    "kind",
    "name",
    "defaults",
    "cases"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "irogen-test-plan"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "count",
          "coverRange",
          "options"
        ],
        "properties": {
          "options": {
            "type": "object"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "anyOf": [
              {
                "$ref": "#/$defs/behaviorExpectation"
              },
              {
                "type": "null"
              }
            ]
          },
          "coverRange": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "maximum": 10000,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "defaults": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "behaviorExpectation": {
      "type": "object",
      "required": [
        "formatVersion",
        "verification"
      ],
      "properties": {
        "forbiddenHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null
          ]
        },
        "measurementAllowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "formatVersion": {
          "const": 1
        },
        "verification": {
          "enum": [
            "proposed",
            "verified"
          ]
        },
        "releasedFieldCount": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 20,
          "minimum": 0
        },
        "requiredHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "type": "object"
}