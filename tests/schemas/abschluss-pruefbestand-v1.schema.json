{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "name", "plannedImages", "verifiedExpectationImages", "diagnosticOrUnassessedImages", "plans", "knownGaps", "commands"],
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "iro-technical-test-inventory" },
    "name": { "type": "string", "minLength": 1 },
    "plannedImages": { "type": "integer", "minimum": 1 },
    "verifiedExpectationImages": { "type": "integer", "minimum": 0 },
    "diagnosticOrUnassessedImages": { "type": "integer", "minimum": 0 },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "images", "cases", "verifiedCases", "unassessedImages", "status", "coverage", "purpose", "limitation"],
        "properties": {
          "path": { "type": "string", "pattern": "^iro-gen/testplans/.+\\.json$" },
          "images": { "type": "integer", "minimum": 1 },
          "cases": { "type": "integer", "minimum": 1 },
          "verifiedCases": { "type": "integer", "minimum": 0 },
          "unassessedImages": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["verified-expectations", "mixed", "diagnostic-only", "checkpoint"] },
          "coverage": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "limitation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "knownGaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "evidence", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "severity": { "enum": ["blocking-product-requirement", "unverified-boundary", "device-phase-boundary", "device-phase-required", "open-product-decision"] },
          "evidence": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "command": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
