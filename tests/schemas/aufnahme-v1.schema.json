{
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "captureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "imageFile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*[.]png$"
    },
    "source": {
      "enum": [
        "generator",
        "camera"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "colorSpace": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAtUtc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conditions": {
      "type": "object",
      "properties": {
        "generator": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "seed": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "parameters": {
                  "type": "object"
                }
              },
              "required": [
                "name",
                "version",
                "seed",
                "parameters"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "camera": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "device": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cameraId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sessionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "measurementGeneration": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sensorTimestampNs": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "timestampSource": {
                  "enum": [
                    "realtime",
                    "unknown",
                    null
                  ]
                },
                "exposureTimeNs": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "iso": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "autoExposure": {
                  "enum": [
                    true,
                    false,
                    null
                  ]
                },
                "autoWhiteBalance": {
                  "enum": [
                    true,
                    false,
                    null
                  ]
                }
              },
              "required": [
                "device",
                "cameraId",
                "sessionId",
                "measurementGeneration",
                "sensorTimestampNs",
                "timestampSource",
                "exposureTimeNs",
                "iso",
                "autoExposure",
                "autoWhiteBalance"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generator",
        "camera"
      ],
      "additionalProperties": false
    },
    "expected": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verification": {
              "enum": [
                "proposed",
                "verified"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "referenceBounds": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "fields": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fieldId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      },
                      "bounds": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "x": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "y": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "width": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "height": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "required": [
                              "x",
                              "y",
                              "width",
                              "height"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "deltaE00": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "measurementAllowed": {
                        "enum": [
                          true,
                          false,
                          null
                        ]
                      },
                      "requiredHint": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "fieldId",
                      "bounds",
                      "deltaE00",
                      "measurementAllowed",
                      "requiredHint"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "measurementAllowed": {
              "enum": [
                true,
                false,
                null
              ]
            },
            "requiredHint": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "verification",
            "basis",
            "referenceBounds",
            "fields",
            "measurementAllowed",
            "requiredHint"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "formatVersion",
    "captureId",
    "description",
    "imageFile",
    "source",
    "width",
    "height",
    "colorSpace",
    "createdAtUtc",
    "conditions",
    "expected"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iro gemeinsame Aufnahmebeschreibung v1",
  "description": "Gemeinsamer PNG-Aufnahmevertrag. null bedeutet unbekannt; tatsächliche Testergebnisse sind hier nicht zulässig.",
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "generator"
          }
        }
      },
      "then": {
        "properties": {
          "conditions": {
            "properties": {
              "generator": {
                "type": "object"
              },
              "camera": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "camera"
          }
        }
      },
      "then": {
        "properties": {
          "conditions": {
            "properties": {
              "camera": {
                "type": "object"
              },
              "generator": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
