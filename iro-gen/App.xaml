<Application x:Class="IroGen.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#E8EDE7"/><Setter Property="Foreground" Value="#1F352B"/>
   <Setter Property="BorderBrush" Value="#CDD6CD"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/><Setter Property="MinHeight" Value="32"/></Style>
 </Application.Resources>
</Application>
