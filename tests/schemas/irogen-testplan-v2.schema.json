{
  "title": "IroGen-Testplan v2",
  "required": [
    "formatVersion",
    "kind",
    "name",
    "defaults",
    "cases"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "irogen-test-plan"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "count",
          "coverRange",
          "options"
        ],
        "properties": {
          "options": {
            "type": "object"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "anyOf": [
              {
                "$ref": "#/$defs/behaviorExpectation"
              },
              {
                "type": "null"
              }
            ]
          },
          "coverRange": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "maximum": 10000,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "defaults": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "behaviorExpectation": {
      "oneOf": [
        {
          "$ref": "#/$defs/behaviorExpectationV1"
        },
        {
          "$ref": "#/$defs/behaviorExpectationV2"
        },
        {
          "$ref": "#/$defs/behaviorExpectationV3"
        }
      ]
    },
    "behaviorExpectationV1": {
      "type": "object",
      "required": [
        "formatVersion",
        "verification"
      ],
      "properties": {
        "forbiddenHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null,
            "UnusableBlur",
            "ChannelLimit",
            "UnevenSurface"
          ]
        },
        "measurementAllowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "formatVersion": {
          "const": 1
        },
        "verification": {
          "enum": [
            "proposed",
            "verified"
          ]
        },
        "releasedFieldCount": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 20,
          "minimum": 0
        },
        "requiredHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null,
            "UnusableBlur",
            "ChannelLimit",
            "UnevenSurface"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "behaviorExpectationV2": {
      "type": "object",
      "required": [
        "formatVersion",
        "verification",
        "fields"
      ],
      "properties": {
        "forbiddenHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null,
            "UnusableBlur",
            "ChannelLimit",
            "UnevenSurface"
          ]
        },
        "measurementAllowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "formatVersion": {
          "const": 2
        },
        "verification": {
          "enum": [
            "proposed",
            "verified"
          ]
        },
        "releasedFieldCount": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 20,
          "minimum": 0
        },
        "requiredHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null,
            "UnusableBlur",
            "ChannelLimit",
            "UnevenSurface"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/fieldExpectation"
          }
        }
      },
      "additionalProperties": false
    },
    "fieldExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "measurementAllowed"
      ],
      "properties": {
        "fieldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "measurementAllowed": {
          "type": "boolean"
        },
        "minimumIntersectionOverUnion": {
          "type": "number",
          "minimum": 0.45,
          "maximum": 1
        },
        "deltaE00": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "absoluteTolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "behaviorExpectationV3": {
      "type": "object",
      "required": [
        "formatVersion",
        "verification",
        "fields",
        "ranking"
      ],
      "properties": {
        "forbiddenHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null,
            "UnusableBlur",
            "ChannelLimit",
            "UnevenSurface"
          ]
        },
        "measurementAllowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "formatVersion": {
          "const": 3
        },
        "verification": {
          "enum": [
            "proposed",
            "verified"
          ]
        },
        "releasedFieldCount": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 20,
          "minimum": 0
        },
        "requiredHint": {
          "enum": [
            "None",
            "Other",
            "PerspectiveTaper",
            null,
            "UnusableBlur",
            "ChannelLimit",
            "UnevenSurface"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/fieldExpectation"
          }
        },
        "ranking": {
          "$ref": "#/$defs/rankingExpectation"
        }
      },
      "additionalProperties": false
    },
    "rankingExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups",
        "tieTolerance"
      ],
      "properties": {
        "tieTolerance": {
          "type": "number",
          "minimum": 0
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "type": "object"
}
